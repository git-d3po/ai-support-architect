# Example PUBLIC Lovable Cloud / Supabase-compatible configuration.
# Replace placeholder values only in an ignored local file or secure deployment settings.
# Public/publishable keys are not privileged service-role secrets.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# The VITE_* variants are exposed to browser bundles. Only publishable values here.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Server-only; never set as VITE_*, never commit a real value.
# Required for trusted private assessment saves in a correctly configured backend.
SUPABASE_SERVICE_ROLE_KEY=
